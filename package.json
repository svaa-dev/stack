{
  "name": "stack",
  "type": "module",
  "scripts": {
    "client": "bunx --bun astro dev",
    "build:client": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "worker": "wrangler dev",
    "dev": "concurrently \"bun run client\" \"bun run worker\"",
    "dryrun:staging": "bun run build:client && wrangler deploy --env staging --dry-run",
    "dryrun:production": "bun run build:client && wrangler deploy --env production --dry-run",
    "deploy:staging": "bun run build:client && wrangler deploy --env staging",
    "deploy:production": "bun run build:client && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "astro": "7.3.1",
    "hono": "^4.13.7",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.22",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.129.0"
  }
}
