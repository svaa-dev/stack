{
  "name": "stack",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun dev:client\" \"bun dev:server\"",
    "dev:client": "bunx --bun astro dev",
    "dev:server": "wrangler dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "bun format:check && bun lint && bun typecheck",
    "fix": "bun format && bun lint:fix && bun typecheck",
    "db:create:staging": "wrangler d1 create stack-staging-db",
    "db:create:production": "wrangler d1 create stack-production-db",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply stack-local-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply stack-staging-db --remote --env staging",
    "db:migrate:production": "wrangler d1 migrations apply stack-production-db --remote --env production",
    "db:seed:local": "wrangler d1 execute stack-local-db --local --file=src/db/seed.local.sql",
    "db:seed:staging": "wrangler d1 execute stack-staging-db --remote --env staging --file=src/db/seed.staging.sql",
    "db:seed:production": "wrangler d1 execute stack-production-db --remote --env production --file=src/db/seed.production.sql",
    "deploy:staging:dry-run": "bun build && wrangler deploy --env staging --dry-run",
    "deploy:production:dry-run": "bun build && wrangler deploy --env production --dry-run",
    "deploy:staging": "bun build && wrangler deploy --env staging",
    "deploy:production": "bun build && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@hono/zod-validator": "^0.9.1",
    "astro": "7.3.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.22",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-sql": "^0.20.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.68.0",
    "wrangler": "^4.129.0"
  }
}
