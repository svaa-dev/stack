{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/assets/*": ["./src/client/assets/*"],
      "@/components/*": ["./src/client/components/*"],
      "@/layouts/*": ["./src/client/layouts/*"],
      "@/styles/*": ["./src/client/styles/*"],
      "@/db/*": ["./src/db/*"]
    }
  }
}
