{
  "name": "stack",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
