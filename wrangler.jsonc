{
  "name": "stack",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stack-development-db",
      "database_id": "local",
      "migrations_dir": "./src/db/migrations"
    }
  ],
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stack-staging-db",
          "database_id": "1a450ad6-348d-4813-8f60-4ac1b52ee2fa",
          "migrations_dir": "./src/db/migrations"
        }
      ]
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stack-production-db",
          "database_id": "",
          "migrations_dir": "./src/db/migrations"
        }
      ]
    }
  }
}
